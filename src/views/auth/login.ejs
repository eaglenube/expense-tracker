<div class="auth-card">
  <div class="d-flex align-items-center gap-2 mb-2">
    <i class="bi bi-wallet2 fs-3 text-primary"></i>
    <h1 class="h3 m-0">ExpenseHub</h1>
  </div>
  <p class="sub">Sign in to track your finances.</p>

  <form action="/login" method="POST" data-loading>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" value="<%= form.email || '' %>" class="form-control" required autofocus />
    </div>
    <div class="mb-3">
      <label class="form-label">Password</label>
      <input type="password" name="password" class="form-control" required />
    </div>
    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" id="remember" name="remember" value="1" />
      <label class="form-check-label" for="remember">Remember me</label>
    </div>
    <button class="btn btn-primary w-100" type="submit">Sign in</button>
  </form>
  <hr class="my-4" />
  <p class="text-center text-muted m-0">Don't have an account? <a href="/register">Create one</a></p>
  <p class="text-center text-muted small mt-3">
    Demo: <strong>admin@example.com</strong> / <strong>password123</strong>
  </p>
</div>
