<div class="auth-card">
  <div class="d-flex align-items-center gap-2 mb-2">
    <i class="bi bi-wallet2 fs-3 text-primary"></i>
    <h1 class="h3 m-0">Create your account</h1>
  </div>
  <p class="sub">Start tracking your income and expenses today.</p>

  <form action="/register" method="POST" data-loading>
    <div class="mb-3">
      <label class="form-label">Full Name</label>
      <input type="text" name="full_name" value="<%= form.full_name || '' %>" class="form-control" required autofocus />
    </div>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" value="<%= form.email || '' %>" class="form-control" required />
    </div>
    <div class="mb-3">
      <label class="form-label">Password</label>
      <input type="password" name="password" class="form-control" minlength="6" required />
      <small class="text-muted">Minimum 6 characters</small>
    </div>
    <button class="btn btn-primary w-100" type="submit">Create account</button>
  </form>
  <hr class="my-4" />
  <p class="text-center text-muted m-0">Already have an account? <a href="/login">Sign in</a></p>
</div>
