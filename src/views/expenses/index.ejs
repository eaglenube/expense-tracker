<% const isEditing = !!editing; %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h2 class="h4 m-0">Expenses</h2>
    <small class="text-muted">Track and manage your expenses.</small>
  </div>
  <button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#expenseForm">
    <i class="bi bi-plus-lg me-1"></i> New Expense
  </button>
</div>

<form class="filters-bar" method="GET" action="/expenses">
  <input class="form-control" name="search" placeholder="Search title..." value="<%= filters.search || '' %>" />
  <select class="form-select" name="category">
    <option value="">All categories</option>
    <% categories.forEach((c) => { %>
      <option value="<%= c.id %>" <%= filters.category === c.id ? 'selected' : '' %>><%= c.name %></option>
    <% }); %>
  </select>
  <select class="form-select" name="payment_method">
    <option value="">All payment methods</option>
    <% paymentMethods.forEach((pm) => { %>
      <option value="<%= pm.id %>" <%= filters.payment_method === pm.id ? 'selected' : '' %>><%= pm.name %></option>
    <% }); %>
  </select>
  <input class="form-control" type="date" name="from_date" value="<%= filters.from_date || '' %>" />
  <input class="form-control" type="date" name="to_date" value="<%= filters.to_date || '' %>" />
  <button class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i>Filter</button>
  <a href="/expenses" class="btn btn-outline-secondary">Reset</a>
</form>

<div class="table-wrapper">
  <% if (!items.length) { %>
    <div class="empty-state">
      <i class="bi bi-receipt"></i>
      <p class="mt-2 mb-0">No expenses yet.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr><th>Date</th><th>Title</th><th>Category</th><th>Payment Method</th><th class="text-end">Amount</th><th>Attachment</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
          <% items.forEach((e) => { %>
            <tr>
              <td><%= formatDate(e.expense_date) %></td>
              <td>
                <strong><%= e.title %></strong>
                <% if (e.description) { %><div class="text-muted small"><%= e.description %></div><% } %>
              </td>
              <td>
                <% if (e.category) { %>
                  <span class="chip" style="background: <%= e.category.color %>22; color: <%= e.category.color %>">
                    <i class="bi <%= e.category.icon %>"></i> <%= e.category.name %>
                  </span>
                <% } %>
              </td>
              <td>
                <% if (e.paymentMethod) { %>
                  <span class="chip"><%= e.paymentMethod.name %></span>
                <% } else { %><span class="text-muted small">—</span><% } %>
              </td>
              <td class="text-end"><strong class="text-danger"><%= formatCurrency(e.amount, e.paymentMethod ? e.paymentMethod.currency : 'INR') %></strong></td>
              <td>
                <% if (e.attachment_path) { %>
                  <a href="<%= e.attachment_path %>" target="_blank" class="btn btn-sm btn-light"><i class="bi bi-paperclip"></i></a>
                <% } else { %>—<% } %>
              </td>
              <td class="text-end">
                <div class="dropdown">
                  <button class="btn btn-sm btn-light" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/expenses?edit=<%= e.id %>"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                    <li>
                      <form action="/expenses/<%= e.id %>?_method=DELETE" method="POST" data-confirm="Delete this expense?">
                        <button class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                      </form>
                    </li>
                  </ul>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
  <%- include('../partials/pagination') %>
</div>

<%- include('./form', { editing, categories, paymentMethods }) %>
<% if (isEditing) { %><div class="offcanvas-backdrop fade show"></div><% } %>
