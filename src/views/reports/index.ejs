<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h2 class="h4 m-0">Reports</h2>
    <small class="text-muted">Date range, category and payment method breakdowns.</small>
  </div>
  <a class="btn btn-outline-primary" href="/reports/export.csv?<%= new URLSearchParams(filters || {}).toString() %>">
    <i class="bi bi-download me-1"></i>Export CSV
  </a>
</div>

<form class="filters-bar" method="GET" action="/reports">
  <input type="date" class="form-control" name="from_date" value="<%= filters.from_date || '' %>" />
  <input type="date" class="form-control" name="to_date" value="<%= filters.to_date || '' %>" />
  <button class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i>Apply</button>
  <a class="btn btn-outline-secondary" href="/reports">Reset</a>
</form>

<div class="cards-row mb-3">
  <div class="stat-card">
    <div class="icon" style="background: #16a34a"><i class="bi bi-arrow-down-circle"></i></div>
    <div><div class="label">Income</div><div class="value text-success"><%= formatCurrency(data.totalIncome) %></div></div>
  </div>
  <div class="stat-card">
    <div class="icon" style="background: #ef4444"><i class="bi bi-arrow-up-circle"></i></div>
    <div><div class="label">Expense</div><div class="value text-danger"><%= formatCurrency(data.totalExpense) %></div></div>
  </div>
  <div class="stat-card">
    <div class="icon" style="background: #6366f1"><i class="bi bi-wallet2"></i></div>
    <div><div class="label">Net</div><div class="value <%= data.net >= 0 ? 'text-success' : 'text-danger' %>"><%= formatCurrency(data.net) %></div></div>
  </div>
</div>

<div class="charts-row">
  <div class="panel">
    <div class="panel-title">By Category</div>
    <% if (!data.byCategory.length) { %>
      <div class="text-muted small">No data for this period.</div>
    <% } else { %>
      <table class="table table-sm">
        <thead><tr><th>Category</th><th class="text-end">Total</th></tr></thead>
        <tbody>
          <% data.byCategory.forEach((r) => { %>
            <tr>
              <td><span class="color-dot me-2" style="background: <%= r.color %>"></span><%= r.name %></td>
              <td class="text-end"><strong><%= formatCurrency(r.total) %></strong></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
  <div class="panel">
    <div class="panel-title">By Payment Method</div>
    <% if (!data.byPayment.length) { %>
      <div class="text-muted small">No data for this period.</div>
    <% } else { %>
      <table class="table table-sm">
        <thead><tr><th>Payment Method</th><th class="text-end">Total</th></tr></thead>
        <tbody>
          <% data.byPayment.forEach((r) => { %>
            <tr>
              <td><span class="color-dot me-2" style="background: <%= r.color %>"></span><%= r.name %></td>
              <td class="text-end"><strong><%= formatCurrency(r.total) %></strong></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
