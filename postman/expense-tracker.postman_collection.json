        {
          "name": "Create (JSON)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Lunch\",\n  \"description\": \"Created via API\",\n  \"amount\": 450,\n  \"expense_date\": \"2026-05-16\",\n  \"category_id\": \"<paste category UUID>\",\n  \"payment_method_id\": \"<paste payment method UUID>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] }
          },
          "event": [
